# Optional GitHub token for higher GitHub API rate limits.
GITHUB_TOKEN=

# Maximum repository archive size accepted by the demo (bytes).
MAX_ARCHIVE_BYTES=50000000

# Responsive-demo limits. Larger production workers can use higher values.
MAX_SOURCE_FILES=1500
MAX_SOURCE_FILE_BYTES=1000000

# Optional cloud models for repository questions. The server reads these.
# The browser never receives the key. Offline excerpts work with no key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
XAI_API_KEY=
XAI_MODEL=grok-3
